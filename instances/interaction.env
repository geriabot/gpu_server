# The interaction system (geriabot/interaction_system), its real sessions: qwen3:8b with the GPU
# alone, so that the latencies compare with those of its experiments. Reached through the tunnel
# of evaluation/real/llm_server.sh (local port 11439). The models are on / (/var/tmp), where there
# is room
OLLAMA_PORT=11436
OLLAMA_MODELS=/var/tmp/${USER}_ollama_models
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=5m
MODELS="qwen3:8b"
EXCLUSIVE=true
