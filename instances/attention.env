# The attention system (geriabot/attention_system): the model of its experiments, qwen2.5vl:32b,
# whole on a 24 GB GPU only with an 8k context. Reached through the tunnel of
# evaluation/real/llm_server.sh (or -L 11434:localhost:11434)
OLLAMA_PORT=11434
OLLAMA_MODELS=$HOME/ollama_models
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=5m
MODELS="qwen2.5vl:32b"
