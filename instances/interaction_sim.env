# The interaction system, its simulated experiments: the model of the system and the simulated
# user (gemma3:12b) loaded together
OLLAMA_PORT=11436
OLLAMA_MODELS=/var/tmp/${USER}_ollama_models
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=5m
MODELS="qwen3:8b gemma3:12b"
